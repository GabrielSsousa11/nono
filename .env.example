# Copie para .env.local. NUNCA versione .env.local.
# Todas as variáveis abaixo são PÚBLICAS (vão para o navegador). Segredos não entram aqui.

# URL pública do site (canonical, sitemap, links de e-mail).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — Settings → API. Use a chave "publishable" (ou "anon" legada). Nunca a service role.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Conteúdo: "official" (padrão) ou "fixtures" (dados SINTÉTICOS, apenas desenvolvimento).
CG_CONTENT_SOURCE=official

# Ambiente de deploy: development | preview | production. Em "production" o build
# falha se CG_CONTENT_SOURCE=fixtures.
CG_DEPLOY_ENV=development

# ---------------------------------------------------------------------------
# SEGREDO DE SERVIDOR — nunca com prefixo NEXT_PUBLIC_, nunca versionar.
# Usado SOMENTE em src/lib/supabase/admin.ts para convidar membros da equipe
# e redefinir MFA (API administrativa de Auth). Sem ela, essas ações ficam
# indisponíveis e a interface informa isso.
SUPABASE_SERVICE_ROLE_KEY=
